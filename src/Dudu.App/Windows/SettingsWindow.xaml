<UserControl
    x:Class="Dudu.App.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WindowSurfaceBrush}">
    <Grid x:Name="RootGrid" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="24,0" Background="{ThemeResource NavigationSurfaceBrush}"
              AutomationProperties.AutomationId="SettingsTitleBar">
            <TextBlock Text="🐻 dudu settings" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1" Margin="24,12,24,0" Padding="12"
                Background="{ThemeResource BlushSurfaceBrush}"
                BorderBrush="{ThemeResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                AutomationProperties.AutomationId="DuduCompanionPanel"
                AutomationProperties.Name="dudu companion panel">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="76" Height="76" CornerRadius="38"
                        Background="{ThemeResource HoneySurfaceBrush}"
                        BorderBrush="{ThemeResource SoftBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image x:Name="DuduFrameImage"
                           Width="70"
                           Height="70"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="DuduCompanionImage"
                           AutomationProperties.Name="dudu current pose" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="DuduCompanionTitle" Text="dudu is here" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DuduCompanionMessage" Text="ready to keep u company" TextWrapping="Wrap" />
                    <TextBlock x:Name="DuduCompanionState" Text="idle, ready to blink" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DuduCompanionStatus" Text="" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DuduCompanionStatus" AutomationProperties.Name="dudu action status" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                    <Button x:Name="DuduPetButton" Content="🤲 pet dudu" Click="DuduPetButton_Click"
                            Background="{ThemeResource CoralActionBrush}"
                            Foreground="{ThemeResource PrimaryButtonForegroundBrush}"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="DuduCompanionPet"
                            AutomationProperties.Name="pet dudu" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="DuduDrinkButton" Content="💧 drink" Click="DuduDrinkButton_Click" AutomationProperties.AutomationId="DuduCompanionDrink" AutomationProperties.Name="ask dudu to drink water" />
                        <Button x:Name="DuduComfortButton" Content="🤗 hug" Click="DuduComfortButton_Click" AutomationProperties.AutomationId="DuduCompanionComfort" AutomationProperties.Name="give dudu a tiny hug" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="2"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="RootNavigation_SelectionChanged"
                        Background="{ThemeResource NavigationSurfaceBrush}">
            <!-- LeftCompact shows only each item's icon until the pane is opened, so
                 every destination needs one; without icons the collapsed pane was a
                 column of blank, unlabeled buttons. -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="home" Tag="home" AutomationProperties.AutomationId="NavHome">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="love notes" Tag="notes" AutomationProperties.AutomationId="NavLoveNotes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="settings" Tag="settings" AutomationProperties.AutomationId="NavSettings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <Frame x:Name="OnboardingFrame" Grid.Row="2" Visibility="Collapsed" />
    </Grid>
</UserControl>
