<Page
    x:Class="Dudu.App.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Abstractions"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="connection" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="ConnectionPageTitle" />
                <TextBlock Text="pairing is optional dudu stays useful offline" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="pairing status" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock x:Name="ConnectionAvailability" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionAvailability" />
                <TextBlock x:Name="ConnectionPairingCode" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionPairingCode" />
                <TextBlock x:Name="ConnectionCodeExpiry" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionCodeExpiry" />
                <Button Content="create 10 min pairing code" Command="{x:Bind ViewModel.CreateCodeCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="ConnectionCreateCode" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="paired sessions" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock x:Name="ConnectionSessionCount" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionSessionCount" />
                <ListView ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}" MaxHeight="180" AutomationProperties.AutomationId="ConnectionSessionsList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PairingSessionSummary">
                            <TextBlock Text="paired sender session" Margin="4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Spacing="8">
                    <Button Content="revoke sender sessions" Command="{x:Bind ViewModel.RevokeSessionsCommand}" AutomationProperties.AutomationId="ConnectionRevokeSessions" />
                    <Button Content="delete remote device data" Command="{x:Bind ViewModel.DeleteRemoteDeviceCommand}" AutomationProperties.AutomationId="ConnectionDeleteRemote" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatusMessage" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionErrorMessage" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
