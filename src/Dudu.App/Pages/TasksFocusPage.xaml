<Page
    x:Class="Dudu.App.Pages.TasksFocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    xmlns:viewModels="using:Dudu.App.ViewModels"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="tasks and focus" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="TasksPageTitle" AutomationProperties.Name="tasks and focus" />
                <TextBlock Text="pick one small step give it protected time" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="active tasks" Style="{StaticResource SectionHeadingStyle}" />
                <ListView x:Name="ActiveTaskList" ItemsSource="{x:Bind ViewModel.ActiveTasks, Mode=OneWay}" SelectionChanged="TaskList_SelectionChanged" MaxHeight="260" AutomationProperties.AutomationId="TasksActiveList" AutomationProperties.Name="active tasks list">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskItem">
                            <StackPanel Margin="4" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Spacing="8">
                    <Button Content="complete selected" Command="{x:Bind ViewModel.CompleteTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="TasksComplete" AutomationProperties.Name="complete selected" />
                    <Button Content="delete selected" Command="{x:Bind ViewModel.RequestDeleteTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}" AutomationProperties.AutomationId="TasksDelete" AutomationProperties.Name="delete selected" />
                </StackPanel>
                <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource WarningBrush}" Visibility="{x:Bind ViewModel.IsConfirmingDeleteTask, Mode=OneWay}" AutomationProperties.AutomationId="TasksDeleteConfirmationPanel" AutomationProperties.Name="delete task confirmation panel">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DeleteTaskPrompt, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="TasksDeleteConfirmationMessage" AutomationProperties.Name="delete task confirmation message" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="confirm delete" Command="{x:Bind ViewModel.DeleteTaskCommand}" CommandParameter="{x:Bind ViewModel.PendingDeleteTask, Mode=OneWay}" AutomationProperties.AutomationId="TasksDeleteConfirm" AutomationProperties.Name="confirm delete task" />
                            <Button Content="cancel" Command="{x:Bind ViewModel.CancelDeleteTaskCommand}" AutomationProperties.AutomationId="TasksDeleteCancel" AutomationProperties.Name="cancel delete task" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="task details" Style="{StaticResource SectionHeadingStyle}" />
                <TextBox Header="title" Text="{x:Bind ViewModel.Title, Mode=TwoWay}" PlaceholderText="whats the next step?" AutomationProperties.AutomationId="TasksTitle" AutomationProperties.Name="title" />
                <TextBox Header="notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="TasksNotes" AutomationProperties.Name="notes" />
                <TextBox x:Name="TaskDueBox" Header="due date and time" TextChanged="TaskDueBox_TextChanged" PlaceholderText="optional" AutomationProperties.AutomationId="TasksDue" AutomationProperties.Name="due date and time" />
                <TextBlock x:Name="TaskDueValidation" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" Visibility="Collapsed" AutomationProperties.AutomationId="TasksDueValidation" AutomationProperties.Name="due date validation" />
                <Button x:Name="SaveTaskButton" Content="save task" Command="{x:Bind ViewModel.SaveTaskCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="TasksSave" AutomationProperties.Name="save task" HorizontalAlignment="Left" />
                <Button Content="new task" Command="{x:Bind ViewModel.NewTaskCommand}" AutomationProperties.AutomationId="TasksNew" AutomationProperties.Name="new task" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="focus" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock x:Name="FocusCurrent" TextWrapping="Wrap" AutomationProperties.AutomationId="FocusCurrent" AutomationProperties.Name="current focus status" />
                <ComboBox Header="focus length" SelectedIndex="1" SelectionChanged="FocusPresetBox_SelectionChanged" AutomationProperties.AutomationId="FocusPreset" AutomationProperties.Name="focus length">
                    <ComboBoxItem Content="15 min" Tag="15" />
                    <ComboBoxItem Content="25 min" Tag="25" />
                    <ComboBoxItem Content="45 min" Tag="45" />
                    <ComboBoxItem Content="60 min" Tag="60" />
                    <ComboBoxItem Content="custom" Tag="0" />
                </ComboBox>
                <NumberBox Header="custom minutes" Value="30" Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact" ValueChanged="CustomDurationBox_ValueChanged" AutomationProperties.AutomationId="FocusCustomDuration" AutomationProperties.Name="custom minutes" />
                <StackPanel Spacing="8">
                    <Button Content="start focus" Command="{x:Bind ViewModel.StartFocusCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="FocusStart" AutomationProperties.Name="start focus" />
                    <Button Content="pause" Command="{x:Bind ViewModel.PauseFocusCommand}" IsEnabled="{x:Bind ViewModel.CanPauseFocus, Mode=OneWay}" AutomationProperties.AutomationId="FocusPause" AutomationProperties.Name="pause" />
                    <Button Content="resume" Command="{x:Bind ViewModel.ResumeFocusCommand}" IsEnabled="{x:Bind ViewModel.CanResumeFocus, Mode=OneWay}" AutomationProperties.AutomationId="FocusResume" AutomationProperties.Name="resume" />
                    <Button Content="extend 5 min" Command="{x:Bind ViewModel.ExtendFocusCommand}" IsEnabled="{x:Bind ViewModel.CanAdjustFocus, Mode=OneWay}" AutomationProperties.AutomationId="FocusExtend" AutomationProperties.Name="extend 5 min" />
                    <Button Content="end focus" Command="{x:Bind ViewModel.EndFocusCommand}" IsEnabled="{x:Bind ViewModel.CanAdjustFocus, Mode=OneWay}" AutomationProperties.AutomationId="FocusEnd" AutomationProperties.Name="end focus" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="completed tasks" Style="{StaticResource SectionHeadingStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.CompletedTasks, Mode=OneWay}" MaxHeight="180" AutomationProperties.AutomationId="TasksCompletedList" AutomationProperties.Name="completed tasks list">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskItem">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Margin="4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="focus history" Style="{StaticResource SectionHeadingStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.FocusHistory, Mode=OneWay}" AutomationProperties.AutomationId="FocusHistoryList" AutomationProperties.Name="focus history list">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:FocusHistoryEntry">
                            <StackPanel Margin="4" Spacing="2">
                                <TextBlock Text="{x:Bind StatusText}" />
                                <TextBlock Text="{x:Bind StartedText}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="TasksStatusMessage" AutomationProperties.Name="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="TasksErrorMessage" AutomationProperties.Name="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
