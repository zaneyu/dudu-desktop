<Page
    x:Class="Dudu.App.Pages.TasksFocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Tasks and Focus" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Choose one small next step, then give it a protected block of time." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Active tasks" Style="{StaticResource SectionHeadingStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.ActiveTasks, Mode=OneWay}" SelectionChanged="TaskList_SelectionChanged" MaxHeight="260" AutomationProperties.AutomationId="TasksActiveList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskItem">
                            <StackPanel Padding="4" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Complete selected" Command="{x:Bind ViewModel.CompleteTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="TasksComplete" />
                    <Button Content="Delete selected" Command="{x:Bind ViewModel.DeleteTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask}" AutomationProperties.AutomationId="TasksDelete" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Task details" Style="{StaticResource SectionHeadingStyle}" />
                <TextBox Header="Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay}" PlaceholderText="What is the next step?" AutomationProperties.AutomationId="TasksTitle" />
                <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="TasksNotes" />
                <TextBox Header="Due date and time" Text="{x:Bind ViewModel.DueText, Mode=TwoWay}" PlaceholderText="Optional" AutomationProperties.AutomationId="TasksDue" />
                <Button Content="Save task" Command="{x:Bind ViewModel.SaveTaskCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="TasksSave" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Focus" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ActiveFocusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="FocusCurrent" />
                <ComboBox Header="Focus length" SelectedIndex="1" SelectionChanged="FocusPresetBox_SelectionChanged" AutomationProperties.AutomationId="FocusPreset">
                    <ComboBoxItem Content="15 minutes" Tag="15" />
                    <ComboBoxItem Content="25 minutes" Tag="25" />
                    <ComboBoxItem Content="45 minutes" Tag="45" />
                    <ComboBoxItem Content="60 minutes" Tag="60" />
                    <ComboBoxItem Content="Custom" Tag="0" />
                </ComboBox>
                <NumberBox Header="Custom minutes" Value="30" Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact" ValueChanged="CustomDurationBox_ValueChanged" AutomationProperties.AutomationId="FocusCustomDuration" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start focus" Command="{x:Bind ViewModel.StartFocusCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="FocusStart" />
                    <Button Content="Pause" Command="{x:Bind ViewModel.PauseFocusCommand}" AutomationProperties.AutomationId="FocusPause" />
                    <Button Content="Resume" Command="{x:Bind ViewModel.ResumeFocusCommand}" AutomationProperties.AutomationId="FocusResume" />
                    <Button Content="Extend 5 minutes" Command="{x:Bind ViewModel.ExtendFocusCommand}" AutomationProperties.AutomationId="FocusExtend" />
                    <Button Content="End focus" Command="{x:Bind ViewModel.EndFocusCommand}" AutomationProperties.AutomationId="FocusEnd" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="TasksStatusMessage" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="TasksErrorMessage" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
