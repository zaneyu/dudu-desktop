<Page
    x:Class="Dudu.App.Pages.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    xmlns:viewmodels="using:Dudu.App.ViewModels"
    Background="{ThemeResource WindowSurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" Margin="32,24,32,32" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="reminders" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="RemindersPageTitle" AutomationProperties.Name="reminders" />
                    <TextBlock Text="gentle little nudges that always respect ur quiet hours" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="⏰" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="your reminders" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <TextBlock Text="no reminders yet. add one below" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.HasNoReminders, Mode=OneWay}" />
                        <ListView x:Name="ReminderList" ItemsSource="{x:Bind ViewModel.Reminders, Mode=OneWay}" SelectionChanged="ReminderList_SelectionChanged" MaxHeight="260" AutomationProperties.AutomationId="RemindersList" AutomationProperties.Name="reminders list">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Reminder">
                                    <Grid Margin="4" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind viewmodels:ReminderScheduleSummary.DescribeWithState(Rule, Enabled)}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.ColumnSpan="2" Content="complete selected" Command="{x:Bind ViewModel.CompleteCommand}" CommandParameter="{x:Bind ViewModel.SelectedReminder, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemindersComplete" AutomationProperties.Name="complete selected" />
                            <Button Grid.Row="1" Content="snooze 15 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="{x:Bind ViewModel.SelectedReminder, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemindersSnooze" AutomationProperties.Name="snooze 15 min" />
                            <Button Grid.Row="1" Grid.Column="1" Content="delete selected" Command="{x:Bind ViewModel.RequestDeleteReminderCommand}" CommandParameter="{x:Bind ViewModel.SelectedReminder, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemindersDelete" AutomationProperties.Name="delete selected reminder" />
                        </Grid>
                        <Border Style="{StaticResource ConfirmCardStyle}" Visibility="{x:Bind ViewModel.IsConfirmingDeleteReminder, Mode=OneWay}" AutomationProperties.AutomationId="RemindersDeleteConfirmationPanel" AutomationProperties.Name="delete reminder confirmation panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.DeleteReminderPrompt, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="RemindersDeleteConfirmationMessage" AutomationProperties.Name="{x:Bind ViewModel.DeleteReminderPrompt, Mode=OneWay}" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="confirm delete" Command="{x:Bind ViewModel.DeleteReminderCommand}" CommandParameter="{x:Bind ViewModel.PendingDeleteReminder, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemindersDeleteConfirm" AutomationProperties.Name="confirm delete reminder" />
                                    <Button Grid.Column="1" Content="cancel" Command="{x:Bind ViewModel.CancelDeleteReminderCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemindersDeleteCancel" AutomationProperties.Name="cancel delete reminder" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="✏️" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="create or edit" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <TextBox Header="title" Text="{x:Bind ViewModel.Title, Mode=TwoWay}" PlaceholderText="for example, drink water" AutomationProperties.AutomationId="RemindersTitle" AutomationProperties.Name="title" />
                        <TextBox Header="details" Text="{x:Bind ViewModel.Details, Mode=TwoWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="RemindersDetails" AutomationProperties.Name="details" />
                        <ComboBox x:Name="ScheduleBox" Header="schedule" SelectedIndex="0" SelectionChanged="ScheduleBox_SelectionChanged" AutomationProperties.AutomationId="RemindersSchedule" AutomationProperties.Name="schedule">
                            <ComboBoxItem Content="once" />
                            <ComboBoxItem Content="daily" />
                            <ComboBoxItem Content="selected weekdays" />
                            <ComboBoxItem Content="every interval" />
                        </ComboBox>
                        <TextBox x:Name="LocalTimeBox" Header="local time" IsEnabled="{x:Bind ViewModel.UsesLocalTime, Mode=OneWay}" TextChanged="LocalTimeBox_TextChanged" PlaceholderText="09:00" AutomationProperties.AutomationId="RemindersLocalTime" AutomationProperties.Name="local time" />
                        <TextBlock x:Name="RemindersLocalTimeValidation" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" Visibility="Collapsed" AutomationProperties.AutomationId="RemindersLocalTimeValidation" AutomationProperties.Name="local time validation" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="weekdays" />
                            <Grid ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="SundayBox" Content="sun" Tag="Sunday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersSunday" AutomationProperties.Name="sun" Grid.Row="0" Grid.Column="0" />
                                <CheckBox x:Name="MondayBox" Content="mon" Tag="Monday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersMonday" AutomationProperties.Name="mon" Grid.Row="0" Grid.Column="1" />
                                <CheckBox x:Name="TuesdayBox" Content="tue" Tag="Tuesday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersTuesday" AutomationProperties.Name="tue" Grid.Row="0" Grid.Column="2" />
                                <CheckBox x:Name="WednesdayBox" Content="wed" Tag="Wednesday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersWednesday" AutomationProperties.Name="wed" Grid.Row="0" Grid.Column="3" />
                                <CheckBox x:Name="ThursdayBox" Content="thu" Tag="Thursday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersThursday" AutomationProperties.Name="thu" Grid.Row="1" Grid.Column="0" />
                                <CheckBox x:Name="FridayBox" Content="fri" Tag="Friday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersFriday" AutomationProperties.Name="fri" Grid.Row="1" Grid.Column="1" />
                                <CheckBox x:Name="SaturdayBox" Content="sat" Tag="Saturday" IsEnabled="{x:Bind ViewModel.UsesWeekdays, Mode=OneWay}" Checked="WeekdayBox_Changed" Unchecked="WeekdayBox_Changed" AutomationProperties.AutomationId="RemindersSaturday" AutomationProperties.Name="sat" Grid.Row="1" Grid.Column="2" />
                            </Grid>
                            <TextBlock Text="used when schedule is set to selected weekdays. pick at least one day" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <NumberBox x:Name="IntervalBox" Header="interval in minutes" IsEnabled="{x:Bind ViewModel.UsesInterval, Mode=OneWay}" Value="60" Minimum="1" Maximum="10080" SpinButtonPlacementMode="Compact" ValueChanged="IntervalBox_ValueChanged" AutomationProperties.AutomationId="RemindersInterval" AutomationProperties.Name="interval in minutes" />
                        <ComboBox x:Name="QuietHoursBox" Header="quiet hours behavior" SelectedIndex="1" SelectionChanged="QuietHoursBox_SelectionChanged" AutomationProperties.AutomationId="RemindersQuietHoursBehavior" AutomationProperties.Name="quiet hours behavior">
                            <ComboBoxItem Content="send now" Tag="DeliverImmediately" />
                            <ComboBoxItem Content="wait till quiet hours end" Tag="WaitUntilQuietHoursEnd" />
                        </ComboBox>
                        <CheckBox Content="reminder enabled" IsChecked="{x:Bind ViewModel.Enabled, Mode=TwoWay}" AutomationProperties.AutomationId="RemindersEnabled" AutomationProperties.Name="reminder enabled" />
                        <Button x:Name="SaveReminderButton" Content="save reminder" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="RemindersSave" AutomationProperties.Name="save reminder" HorizontalAlignment="Left" />
                        <Button Content="new reminder" Command="{x:Bind ViewModel.NewReminderCommand}" AutomationProperties.AutomationId="RemindersNew" AutomationProperties.Name="new reminder" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HoneyCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="💡" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="helpful defaults" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <CheckBox Content="suggest water breaks" IsChecked="{x:Bind ViewModel.HydrationRemindersEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="RemindersHydration" AutomationProperties.Name="suggest water breaks" />
                        <CheckBox Content="suggest short breaks" IsChecked="{x:Bind ViewModel.BreakRemindersEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="RemindersBreaks" AutomationProperties.Name="suggest short breaks" />
                        <CheckBox Content="evening check-in at 20:00" IsChecked="{x:Bind ViewModel.EveningCheckInEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="RemindersEveningCheckIn" AutomationProperties.Name="evening check-in at 20:00" />
                        <CheckBox Content="bedtime goodnight at 22:00" IsChecked="{x:Bind ViewModel.BedtimeRitualEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="RemindersBedtimeRitual" AutomationProperties.Name="bedtime goodnight at 22:00" />
                        <TextBlock Text="both are off until you choose them. times use your local time zone. these are local-only prompts, not messages from anyone; check-ins stay on this device. quiet hours still apply." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Button Content="save reminder preferences" Command="{x:Bind ViewModel.SaveReminderPreferencesCommand}" AutomationProperties.AutomationId="RemindersSavePreferences" AutomationProperties.Name="save reminder preferences" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky feedback: what just happened stays in view at the bottom of the
             page instead of landing below the fold. -->
        <StackPanel Grid.Row="1" MaxWidth="880" Margin="32,0,32,16" Spacing="6" AutomationProperties.LiveSetting="Polite">
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RemindersStatusMessage" AutomationProperties.Name="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RemindersErrorMessage" AutomationProperties.Name="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
