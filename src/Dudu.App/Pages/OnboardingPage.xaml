<Page
    x:Class="Dudu.App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageRoot" MaxWidth="720" Padding="32" Spacing="16">
            <TextBlock Text="hi, i'm dudu 🐻 let's set up a calm start" TextWrapping="Wrap" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="OnboardingProgress" AutomationProperties.AutomationId="OnboardingProgress" AutomationProperties.Name="onboarding progress" AutomationProperties.LiveSetting="Polite" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            <Border Style="{StaticResource BlushCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="RecipientStep" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="👋" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="what should dudu call you?" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <TextBlock Text="whatever feels natural. dudu will use it in little greetings" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBox x:Name="RecipientNameBox" Header="your name" AutomationProperties.AutomationId="OnboardingRecipientName" AutomationProperties.Name="your name" PlaceholderText="for example, mia" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceStep" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🎨" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="choose a cozy look" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <ComboBox x:Name="ThemeBox" Header="appearance" AutomationProperties.AutomationId="OnboardingTheme" AutomationProperties.Name="appearance" SelectedIndex="0">
                            <ComboBoxItem Content="use windows setting" Tag="System" />
                            <ComboBoxItem Content="light" Tag="Light" />
                            <ComboBoxItem Content="dark" Tag="Dark" />
                        </ComboBox>
                        <CheckBox x:Name="ReducedMotionBox" Content="use reduced motion" AutomationProperties.AutomationId="OnboardingReducedMotion" AutomationProperties.Name="use reduced motion" />
                        <TextBlock Text="reduced motion keeps dudu expressive without extra movement" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="PairingStep" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🔗" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="pair later if you want" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <TextBlock Text="pairing lets someone you trust send u encrypted notes. it's optional, and dudu works fine without it" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PairingStatus" AutomationProperties.AutomationId="OnboardingPairingStatus" AutomationProperties.Name="pairing status" AutomationProperties.LiveSetting="Polite" Text="pairing is optional" TextWrapping="Wrap" />
                        <Button x:Name="PairingCheckButton" Content="check pairing availability" AutomationProperties.AutomationId="OnboardingPairingCheck" AutomationProperties.Name="check pairing availability" Click="PairingCheckButton_Click" />
                        <Button x:Name="SkipPairingButton" Content="skip for now" AutomationProperties.AutomationId="OnboardingSkipPairing" AutomationProperties.Name="skip for now" Click="SkipPairingButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="OnboardingStatusMessage" AutomationProperties.AutomationId="OnboardingStatusMessage" AutomationProperties.Name="onboarding status" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OnboardingValidationMessage" AutomationProperties.AutomationId="OnboardingValidationMessage" AutomationProperties.Name="validation message" AutomationProperties.LiveSetting="Assertive" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="StartupRecoveryPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="StartupRecoveryMessage" AutomationProperties.AutomationId="OnboardingStartupRecoveryMessage" AutomationProperties.Name="startup recovery message" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" />
                        <Button x:Name="RetryStartupButton" Content="retry startup registration" AutomationProperties.AutomationId="OnboardingRetryStartupRegistration" AutomationProperties.Name="retry startup registration" Click="RetryStartupButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="back" AutomationProperties.AutomationId="OnboardingBack" AutomationProperties.Name="back" Click="BackButton_Click" Grid.Column="0" />
                <Button x:Name="NextButton" Content="next" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="OnboardingNext" AutomationProperties.Name="next" Click="NextButton_Click" Grid.Column="2" />
                <Button x:Name="CompleteButton" Content="finish setup" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="OnboardingComplete" AutomationProperties.Name="finish setup" Click="CompleteButton_Click" Grid.Column="2" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
