<Page
    x:Class="Dudu.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Abstractions"
    Background="{ThemeResource WindowSurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" Margin="32,24,32,32" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="settings" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="SettingsPageTitle" AutomationProperties.Name="settings" />
                    <TextBlock Text="make dudu look and move just how u like, keep ur partner connected, or start fresh" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Safe mode: only "delete my data" (this pc only) is offered, and closing
                     this window exits dudu. No backup or restore here; automatic recovery of
                     a damaged database still runs on its own. -->
                <Border Style="{StaticResource ConfirmCardStyle}" Visibility="{x:Bind ViewModel.IsSafeMode}" AutomationProperties.AutomationId="SettingsSafeModeNotice" AutomationProperties.Name="dudu is in safe mode">
                    <StackPanel Spacing="6">
                        <TextBlock Text="dudu is in safe mode" FontWeight="SemiBold" />
                        <TextBlock Text="dudu had trouble starting, so only delete my data works here and it wipes this pc only. close this window to exit dudu" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSafeModeMessage" AutomationProperties.Name="dudu had trouble starting, so only delete my data works here and it wipes this pc only. close this window to exit dudu" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowsFullSettings}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🎨" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                                <TextBlock Grid.Column="1" Text="look and motion" Style="{StaticResource SectionHeadingStyle}" />
                            </Grid>
                            <ComboBox x:Name="ThemeBox" Header="theme" SelectedIndex="0" SelectionChanged="ThemeBox_SelectionChanged" AutomationProperties.AutomationId="AppearanceTheme" AutomationProperties.Name="theme">
                                <ComboBoxItem Content="use windows setting" Tag="System" />
                                <ComboBoxItem Content="light" Tag="Light" />
                                <ComboBoxItem Content="dark" Tag="Dark" />
                            </ComboBox>
                            <CheckBox Content="use reduced motion" IsChecked="{x:Bind ViewModel.ReducedMotion, Mode=TwoWay}" AutomationProperties.AutomationId="AppearanceReducedMotion" AutomationProperties.Name="use reduced motion" />
                            <TextBlock Text="reduced motion uses static poses less movement" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <CheckBox Content="cute sounds" IsChecked="{x:Bind ViewModel.SoundsEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="AppearanceSoundsEnabled" AutomationProperties.Name="cute sounds" />
                            <Slider Header="sound volume" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" StepFrequency="0.01" IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.SoundVolume, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SoundsEnabled, Mode=OneWay}" AutomationProperties.AutomationId="AppearanceSoundVolume" AutomationProperties.Name="sound volume" />
                            <TextBlock Text="{x:Bind ViewModel.SoundVolumeLabel, Mode=OneWay}" AutomationProperties.AutomationId="AppearanceSoundVolumeLabel" AutomationProperties.Name="{x:Bind ViewModel.SoundVolumeLabel, Mode=OneWay}" />
                            <Slider Header="pet size" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.25" StepFrequency="0.05" IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.PetScale, Mode=TwoWay}" AutomationProperties.AutomationId="AppearancePetScale" AutomationProperties.Name="pet size" />
                            <TextBlock Text="{x:Bind ViewModel.PetScaleLabel, Mode=OneWay}" AutomationProperties.AutomationId="AppearancePetScaleLabel" AutomationProperties.Name="{x:Bind ViewModel.PetScaleLabel, Mode=OneWay}" />
                            <ComboBox Header="monitor" ItemsSource="{x:Bind ViewModel.MonitorOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.MonitorDeviceName, Mode=TwoWay}" AutomationProperties.AutomationId="AppearanceMonitor" AutomationProperties.Name="monitor" />
                            <!-- Saved by "save appearance" below, so they live in this card. -->
                            <CheckBox Content="keep dudu above other windows" IsChecked="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" AutomationProperties.AutomationId="AppearanceAlwaysOnTop" AutomationProperties.Name="keep dudu above other windows" />
                            <CheckBox Content="hide dudu during fullscreen work" IsChecked="{x:Bind ViewModel.HideDuringFullscreen, Mode=TwoWay}" AutomationProperties.AutomationId="AppearanceHideFullscreen" AutomationProperties.Name="hide dudu during fullscreen work" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="save appearance" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AppearanceSave" AutomationProperties.Name="save appearance" />
                                <Button Grid.Column="1" Content="save pet placement" Command="{x:Bind ViewModel.SavePlacementCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AppearanceSavePlacement" AutomationProperties.Name="save pet placement" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🚀" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                                <TextBlock Grid.Column="1" Text="when windows starts" Style="{StaticResource SectionHeadingStyle}" />
                            </Grid>
                            <CheckBox x:Name="StartupToggle" Content="launch dudu when i sign in" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" AutomationProperties.AutomationId="SettingsLaunchAtSignIn" AutomationProperties.Name="launch dudu when i sign in" />
                            <TextBlock Text="startup registration is managed locally on this pc" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel x:Name="StartupRecoveryPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="StartupRecoveryMessage" AutomationProperties.AutomationId="SettingsStartupRecoveryMessage" AutomationProperties.Name="startup recovery message" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" />
                                <Button x:Name="RetryStartupButton" Content="retry startup registration" AutomationProperties.AutomationId="SettingsRetryStartupRegistration" AutomationProperties.Name="retry startup registration" Click="RetryStartupButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Text="partner connection" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.AutomationId="SettingsConnectionHeading" AutomationProperties.Name="partner connection" />
                        <TextBlock Text="pairing is optional. dudu stays useful offline" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource BlushCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🔗" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                                <TextBlock Grid.Column="1" Text="pairing status" Style="{StaticResource SectionHeadingStyle}" />
                            </Grid>
                            <TextBlock x:Name="ConnectionAvailability" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionAvailability" AutomationProperties.Name="pairing availability" />
                            <TextBlock x:Name="ConnectionPairingCode" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionPairingCode" AutomationProperties.Name="pairing code" />
                            <TextBlock x:Name="ConnectionCodeExpiry" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionCodeExpiry" AutomationProperties.Name="pairing code expiry" />
                            <StackPanel Spacing="8">
                                <Button Content="create 10 min pairing code" Command="{x:Bind ViewModel.Connection.CreateCodeCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="ConnectionCreateCode" AutomationProperties.Name="create 10 min pairing code" />
                                <Button Content="check again" Command="{x:Bind ViewModel.Connection.RefreshCommand}" AutomationProperties.AutomationId="ConnectionRefresh" AutomationProperties.Name="check pairing status again" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="📱" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                                <TextBlock Grid.Column="1" Text="paired sessions" Style="{StaticResource SectionHeadingStyle}" />
                            </Grid>
                            <TextBlock x:Name="ConnectionSessionCount" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionSessionCount" AutomationProperties.Name="paired session count" />
                            <ListView ItemsSource="{x:Bind ViewModel.Connection.Sessions, Mode=OneWay}" MaxHeight="180" AutomationProperties.AutomationId="ConnectionSessionsList" AutomationProperties.Name="paired sessions list">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PairingSessionSummary">
                                        <TextBlock Text="paired sender session" Margin="4" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Spacing="8">
                                <Button Content="revoke sender sessions" Command="{x:Bind ViewModel.Connection.RequestRevokeSessionsCommand}" AutomationProperties.AutomationId="ConnectionRevokeSessions" AutomationProperties.Name="revoke sender sessions" />
                                <Button Content="delete remote device data" Command="{x:Bind ViewModel.Connection.RequestDeleteRemoteDeviceCommand}" AutomationProperties.AutomationId="ConnectionDeleteRemote" AutomationProperties.Name="delete remote device data" />
                                <Button Content="forget pairing on this pc" Command="{x:Bind ViewModel.Connection.RequestForgetPairingCommand}" AutomationProperties.AutomationId="ConnectionForgetPairing" AutomationProperties.Name="forget pairing on this pc" />
                            </StackPanel>
                            <Border Style="{StaticResource ConfirmCardStyle}" Visibility="{x:Bind ViewModel.Connection.HasPendingConfirmation, Mode=OneWay}" AutomationProperties.AutomationId="ConnectionConfirmationPanel" AutomationProperties.Name="confirmation panel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.Connection.ConfirmationTitle, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Connection.ConfirmationMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="ConnectionConfirmationMessage" AutomationProperties.Name="{x:Bind ViewModel.Connection.ConfirmationMessage, Mode=OneWay}" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind ViewModel.Connection.ConfirmationButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.Connection.ConfirmCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConnectionConfirm" AutomationProperties.Name="confirm action" />
                                        <Button Grid.Column="1" Content="cancel" Command="{x:Bind ViewModel.Connection.CancelConfirmationCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConnectionCancel" AutomationProperties.Name="cancel" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconChipStyle}"><TextBlock Text="🔐" Style="{StaticResource ChipEmojiStyle}" AutomationProperties.AccessibilityView="Raw" /></Border>
                            <TextBlock Grid.Column="1" Text="your data" Style="{StaticResource SectionHeadingStyle}" />
                        </Grid>
                        <TextBlock Text="what is stored: ur name, these settings, where dudu sits, and the partner pairing keys stay on this pc. partner notes arrive encrypted. once u open one it is kept on this pc (and in dudus automatic backups) so u can read it again, until u delete it from opened notes or delete ur data here" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="SettingsStoredData" AutomationProperties.Name="what is stored on this pc" />
                        <TextBlock Text="delete my data removes ur partner connection from the partner server first, then wipes everything dudu keeps on this pc" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Button Content="delete my data" Command="{x:Bind ViewModel.RequestDeleteMyDataCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SettingsDeleteMyData" AutomationProperties.Name="delete my data" />
                        <Border Style="{StaticResource ConfirmCardStyle}" Visibility="{x:Bind ViewModel.IsDeleteConfirmVisible, Mode=OneWay}" AutomationProperties.AutomationId="SettingsDeleteConfirmationPanel" AutomationProperties.Name="delete my data confirmation panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="are u sure?" FontWeight="SemiBold" />
                                <TextBlock Text="this deletes everything dudu keeps, forever. it cannot be undone" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="SettingsDeleteConfirmationMessage" AutomationProperties.Name="this deletes everything dudu keeps, forever. it cannot be undone" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="yes, delete it all" Command="{x:Bind ViewModel.ConfirmDeleteMyDataCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SettingsDeleteConfirm" AutomationProperties.Name="yes, delete it all" />
                                    <Button Grid.Column="1" Content="cancel" Command="{x:Bind ViewModel.CancelDeleteMyDataCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SettingsDeleteCancel" AutomationProperties.Name="cancel" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="wipe this pc only" Command="{x:Bind ViewModel.WipeThisPcOnlyCommand}" Visibility="{x:Bind ViewModel.IsWipeThisPcOnlyVisible, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SettingsWipeThisPcOnly" AutomationProperties.Name="wipe this pc only" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky feedback: what just happened stays in view at the bottom of the
             page instead of landing below the fold. -->
        <StackPanel Grid.Row="1" MaxWidth="880" Margin="32,0,32,16" Spacing="6" AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="working on it" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="SettingsBusy" AutomationProperties.Name="working on it" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Connection.IsBusy, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.Connection.IsBusy, Mode=OneWay}" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="working on it" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="ConnectionBusy" AutomationProperties.Name="working on it" />
            </StackPanel>
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AppearanceStatusMessage" AutomationProperties.Name="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AppearanceErrorMessage" AutomationProperties.Name="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.Connection.HasStatus, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.Connection.HasStatus, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Connection.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatusMessage" AutomationProperties.Name="{x:Bind ViewModel.Connection.StatusMessage, Mode=OneWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind ViewModel.Connection.HasError, Mode=OneWay}">
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.Connection.HasError, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Connection.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionErrorMessage" AutomationProperties.Name="{x:Bind ViewModel.Connection.ErrorMessage, Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
