<Page
    x:Class="Dudu.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="HomePageTitle" />
                <TextBlock Text="A quiet view of Dudu and the next useful thing." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource BlushSurfaceBrush}" BorderBrush="{ThemeResource LavenderBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dudu's status" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PauseDescription, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomePauseDescription" />
                    <TextBlock x:Name="HomeNextReminder" Text="{x:Bind ViewModel.NextReminderText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeNextReminder" />
                    <TextBlock x:Name="HomeActiveFocus" Text="{x:Bind ViewModel.ActiveFocusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeActiveFocus" />
                    <TextBlock x:Name="HomePetState" Text="{x:Bind ViewModel.PetStateText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomePetState" />
                    <TextBlock x:Name="HomePetAnimation" Text="{x:Bind ViewModel.PetAnimationText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="HomePetAnimation" />
                    <StackPanel Spacing="8">
                        <Button Content="Pet Dudu" Command="{x:Bind ViewModel.PetCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="OverlayActionPet" />
                        <Button Content="Pause for one hour" Command="{x:Bind ViewModel.PauseForOneHourCommand}" AutomationProperties.AutomationId="HomePause" />
                        <Button Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}" AutomationProperties.AutomationId="HomeResume" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="Dudu actions" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="These keyboard-accessible controls are the Settings equivalents of Dudu's action bubble." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <Button Content="Drink water" Tag="DrinkWater" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionDrinkWater" />
                    <Button Content="Start focus" Tag="StartFocus" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionStartFocus" />
                    <Button Content="Open tasks" Tag="Tasks" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionTasks" />
                    <Button Content="Open love notes" Tag="LoveNote" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionLoveNote" />
                    <Button Content="Comfort me" Tag="ComfortMe" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionComfortMe" />
                </StackPanel>
                <TextBlock x:Name="HomeActionStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HomeActionStatus" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Comfort actions" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Choose a gentle action without relying on the overlay. Nothing here records or infers a mood." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <Button Content="Breathe with me" Tag="BreatheWithMe" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionBreatheWithMe" />
                    <Button Content="Tiny hug" Tag="TinyHug" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionTinyHug" />
                    <Button Content="Read a love note" Tag="ReadALoveNote" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionReadALoveNote" />
                    <Button Content="Take a five-minute break" Tag="TakeAFiveMinuteBreak" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionTakeAFiveMinuteBreak" />
                    <Button Content="Close comfort" Tag="Close" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionClose" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Countdowns" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Keep one meaningful date in view. Leave the target blank to use tomorrow." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <TextBox Header="Title" Text="{x:Bind ViewModel.CountdownTitle, Mode=TwoWay}" PlaceholderText="For example, next visit" AutomationProperties.AutomationId="HomeCountdownTitle" />
                    <TextBox x:Name="CountdownTargetBox" Header="Target" PlaceholderText="Optional" TextChanged="CountdownTarget_Changed" AutomationProperties.AutomationId="HomeCountdownTarget" />
                    <TextBlock x:Name="CountdownTargetValidation" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" Visibility="Collapsed" AutomationProperties.AutomationId="HomeCountdownTargetValidation" />
                    <Button x:Name="HomeSaveCountdownButton" Content="Save" Command="{x:Bind ViewModel.CreateCountdownCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCountdown" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Countdowns, Mode=OneWay}" SelectionChanged="CountdownList_SelectionChanged" MaxHeight="220" AutomationProperties.AutomationId="HomeCountdownList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Countdown"><TextBlock Text="{x:Bind Title}" Margin="4" TextWrapping="Wrap" /></DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Delete selected countdown" Command="{x:Bind ViewModel.DeleteCountdownCommand}" CommandParameter="{x:Bind ViewModel.SelectedCountdown}" AutomationProperties.AutomationId="HomeDeleteCountdown" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Quick check-in" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="This is optional and stays on this PC. Dudu does not infer a mood." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <ComboBox Header="How are you feeling?" SelectedIndex="1" SelectionChanged="MoodBox_SelectionChanged" AutomationProperties.AutomationId="HomeMoodChoice">
                    <ComboBoxItem Content="Great" Tag="Great" />
                    <ComboBoxItem Content="Okay" Tag="Okay" />
                    <ComboBoxItem Content="Tired" Tag="Tired" />
                    <ComboBoxItem Content="Rough" Tag="Rough" />
                </ComboBox>
                <TextBox Header="Note" Text="{x:Bind ViewModel.CheckInNote, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="HomeCheckInNote" />
                <Button Content="Save check-in" Command="{x:Bind ViewModel.RecordCheckInCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCheckIn" />
                <TextBlock x:Name="HomeCheckInSummary" Text="{x:Bind ViewModel.CheckInSummaryText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeCheckInSummary" />
                <ItemsControl x:Name="HomeCheckInHistory" ItemsSource="{x:Bind ViewModel.RecentCheckIns, Mode=OneWay}" AutomationProperties.AutomationId="HomeCheckInHistory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MoodCheckIn">
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Text="{x:Bind Choice}" />
                                <TextBlock Text="{x:Bind CreatedUtc}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Launch Dudu when I sign in" IsChecked="{x:Bind Startup.Current.LaunchAtSignIn, Mode=OneWay}" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" AutomationProperties.AutomationId="SettingsLaunchAtSignIn" />
                <TextBlock Text="Startup registration is managed locally on this PC." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel x:Name="StartupRecoveryPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="StartupRecoveryMessage" AutomationProperties.AutomationId="HomeStartupRecoveryMessage" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" />
                    <Button x:Name="RetryStartupButton" Content="Retry startup registration" AutomationProperties.AutomationId="HomeRetryStartupRegistration" Click="RetryStartupButton_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeStatusMessage" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeErrorMessage" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
