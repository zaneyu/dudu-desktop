<Page
    x:Class="Dudu.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="A quiet view of Dudu and the next useful thing." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource BlushSurfaceBrush}" BorderBrush="{ThemeResource LavenderBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dudu's status" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PauseDescription, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.NextReminderText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeNextReminder" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveFocusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeActiveFocus" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pet Dudu" Command="{x:Bind ViewModel.PetCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomePet" />
                        <Button Content="Pause for one hour" Command="{x:Bind ViewModel.PauseForOneHourCommand}" AutomationProperties.AutomationId="HomePause" />
                        <Button Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}" AutomationProperties.AutomationId="HomeResume" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="Countdowns" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Keep one meaningful date in view. Leave the target blank to use tomorrow." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Title" Text="{x:Bind ViewModel.CountdownTitle, Mode=TwoWay}" PlaceholderText="For example, next visit" AutomationProperties.AutomationId="HomeCountdownTitle" Grid.Column="0" />
                    <TextBox Header="Target" Text="{x:Bind ViewModel.CountdownTargetText, Mode=TwoWay}" PlaceholderText="Optional" AutomationProperties.AutomationId="HomeCountdownTarget" Grid.Column="1" />
                    <Button Content="Save" Command="{x:Bind ViewModel.CreateCountdownCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCountdown" Grid.Column="2" VerticalAlignment="Bottom" />
                </Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Countdowns, Mode=OneWay}" SelectionChanged="CountdownList_SelectionChanged" MaxHeight="220" AutomationProperties.AutomationId="HomeCountdownList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Countdown">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                <TextBlock Text="{x:Bind Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Delete selected countdown" Command="{x:Bind ViewModel.DeleteCountdownCommand}" CommandParameter="{x:Bind ViewModel.SelectedCountdown}" AutomationProperties.AutomationId="HomeDeleteCountdown" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Quick check-in" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="This is optional and stays on this PC. Dudu does not infer a mood." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <ComboBox Header="How are you feeling?" SelectedIndex="1" SelectionChanged="MoodBox_SelectionChanged" AutomationProperties.AutomationId="HomeMoodChoice">
                    <ComboBoxItem Content="Great" Tag="Great" />
                    <ComboBoxItem Content="Okay" Tag="Okay" />
                    <ComboBoxItem Content="Tired" Tag="Tired" />
                    <ComboBoxItem Content="Rough" Tag="Rough" />
                </ComboBox>
                <TextBox Header="Note" Text="{x:Bind ViewModel.CheckInNote, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="HomeCheckInNote" />
                <Button Content="Save check-in" Command="{x:Bind ViewModel.RecordCheckInCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCheckIn" HorizontalAlignment="Left" />
                <TextBlock Text="{x:Bind ViewModel.CheckInSummaryText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeCheckInSummary" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Launch Dudu when I sign in" IsChecked="{x:Bind Startup.Current.LaunchAtSignIn, Mode=OneWay}" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" AutomationProperties.AutomationId="SettingsLaunchAtSignIn" />
                <TextBlock Text="Startup registration is managed locally on this PC." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel x:Name="StartupRecoveryPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="StartupRecoveryMessage" AutomationProperties.AutomationId="HomeStartupRecoveryMessage" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" />
                    <Button x:Name="RetryStartupButton" Content="Retry startup registration" AutomationProperties.AutomationId="HomeRetryStartupRegistration" Click="RetryStartupButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeStatusMessage" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeErrorMessage" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
