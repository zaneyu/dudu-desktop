<Page
    x:Class="Dudu.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Dudu.Core.Models"
    Background="{ThemeResource WindowSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="home" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="HomePageTitle" AutomationProperties.Name="home" />
                <TextBlock Text="a quiet view of dudu and whats next" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource BlushSurfaceBrush}" BorderBrush="{ThemeResource LavenderBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="dudu status" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PauseDescription, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomePauseDescription" AutomationProperties.Name="pause status" />
                    <TextBlock x:Name="HomeNextReminder" Text="{x:Bind ViewModel.NextReminderText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeNextReminder" AutomationProperties.Name="next reminder" />
                    <TextBlock x:Name="HomeActiveFocus" Text="{x:Bind ViewModel.ActiveFocusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeActiveFocus" AutomationProperties.Name="active focus status" />
                    <TextBlock x:Name="HomePetState" Text="{x:Bind ViewModel.PetStateText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomePetState" AutomationProperties.Name="pet state" />
                    <TextBlock x:Name="HomePetAnimation" Text="{x:Bind ViewModel.PetAnimationText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="HomePetAnimation" AutomationProperties.Name="pet animation" />
                    <StackPanel Spacing="8">
                        <Button Content="pet dudu" Command="{x:Bind ViewModel.PetCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="OverlayActionPet" AutomationProperties.Name="pet dudu" />
                        <Button Content="pause for one hour" Command="{x:Bind ViewModel.PauseForOneHourCommand}" AutomationProperties.AutomationId="HomePause" AutomationProperties.Name="pause for one hour" />
                        <Button Content="resume" Command="{x:Bind ViewModel.ResumeCommand}" AutomationProperties.AutomationId="HomeResume" AutomationProperties.Name="resume" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="dudu actions" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="same as dudus bubble but keyboard ok" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <Button Content="drink water" Tag="DrinkWater" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionDrinkWater" AutomationProperties.Name="drink water" />
                    <Button Content="start focus" Tag="StartFocus" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionStartFocus" AutomationProperties.Name="start focus" />
                    <Button Content="open tasks" Tag="Tasks" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionTasks" AutomationProperties.Name="open tasks" />
                    <Button Content="open love notes" Tag="LoveNote" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionLoveNote" AutomationProperties.Name="open love notes" />
                    <Button Content="comfort me" Tag="ComfortMe" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionComfortMe" AutomationProperties.Name="comfort me" />
                    <Button Content="eat together 🍚" Tag="EatTogether" Click="OverlayAction_Click" AutomationProperties.AutomationId="OverlayActionEatTogether" AutomationProperties.Name="eat together or done eating" />
                </StackPanel>
                <TextBlock x:Name="HomeActionStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HomeActionStatus" AutomationProperties.Name="action status" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="comfort actions" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="pick a gentle action no mood tracked" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <Button Content="breathe with me" Tag="BreatheWithMe" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionBreatheWithMe" AutomationProperties.Name="breathe with me" />
                    <Button Content="tiny hug" Tag="TinyHug" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionTinyHug" AutomationProperties.Name="tiny hug" />
                    <Button Content="read a love note" Tag="ReadALoveNote" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionReadALoveNote" AutomationProperties.Name="read a love note" />
                    <Button Content="take a five-minute break" Tag="TakeAFiveMinuteBreak" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionTakeAFiveMinuteBreak" AutomationProperties.Name="take a five-minute break" />
                    <Button Content="close comfort" Tag="Close" Click="ComfortAction_Click" AutomationProperties.AutomationId="OverlayComfortActionClose" AutomationProperties.Name="close comfort" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="countdowns" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="one date to look forward to" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock x:Name="HomeNextCountdown" Text="{x:Bind ViewModel.NextCountdownText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeNextCountdown" AutomationProperties.Name="next countdown" />
                <StackPanel Spacing="8">
                    <TextBox Header="title" Text="{x:Bind ViewModel.CountdownTitle, Mode=TwoWay}" PlaceholderText="for example, next visit" AutomationProperties.AutomationId="HomeCountdownTitle" AutomationProperties.Name="title" />
                    <TextBox x:Name="CountdownTargetBox" Header="target" PlaceholderText="blank means tmrw" TextChanged="CountdownTarget_Changed" AutomationProperties.AutomationId="HomeCountdownTarget" AutomationProperties.Name="target" />
                    <TextBlock x:Name="CountdownTargetValidation" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" Visibility="Collapsed" AutomationProperties.AutomationId="HomeCountdownTargetValidation" AutomationProperties.Name="countdown target validation" />
                    <Button x:Name="HomeSaveCountdownButton" Content="save" Command="{x:Bind ViewModel.CreateCountdownCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCountdown" AutomationProperties.Name="save" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Countdowns, Mode=OneWay}" SelectionChanged="CountdownList_SelectionChanged" MaxHeight="220" AutomationProperties.AutomationId="HomeCountdownList" AutomationProperties.Name="countdowns list">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Countdown"><TextBlock Text="{x:Bind Title}" Margin="4" TextWrapping="Wrap" /></DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="delete selected countdown" Command="{x:Bind ViewModel.RequestDeleteCountdownCommand}" CommandParameter="{x:Bind ViewModel.SelectedCountdown, Mode=OneWay}" AutomationProperties.AutomationId="HomeDeleteCountdown" AutomationProperties.Name="delete selected countdown" />
                <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource WarningBrush}" Visibility="{x:Bind ViewModel.IsConfirmingDeleteCountdown, Mode=OneWay}" AutomationProperties.AutomationId="HomeDeleteCountdownConfirmationPanel" AutomationProperties.Name="delete countdown confirmation panel">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DeleteCountdownPrompt, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="HomeDeleteCountdownConfirmationMessage" AutomationProperties.Name="delete countdown confirmation message" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="confirm delete" Command="{x:Bind ViewModel.DeleteCountdownCommand}" CommandParameter="{x:Bind ViewModel.PendingDeleteCountdown, Mode=OneWay}" AutomationProperties.AutomationId="HomeDeleteCountdownConfirm" AutomationProperties.Name="confirm delete countdown" />
                            <Button Content="cancel" Command="{x:Bind ViewModel.CancelDeleteCountdownCommand}" AutomationProperties.AutomationId="HomeDeleteCountdownCancel" AutomationProperties.Name="cancel delete countdown" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.CheckInSectionHeading, Mode=OneWay}" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="optional, saved on this pc only. dudu's check-in, not a message from your partner. enable the evening prompt in Reminders." TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.YesterdayReflectionText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeYesterdayReflection" AutomationProperties.Name="yesterday's check-in" />
                <ComboBox Header="how are u feeling?" SelectedIndex="1" SelectionChanged="MoodBox_SelectionChanged" AutomationProperties.AutomationId="HomeMoodChoice" AutomationProperties.Name="how are u feeling?">
                    <ComboBoxItem Content="great" Tag="Great" />
                    <ComboBoxItem Content="okay" Tag="Okay" />
                    <ComboBoxItem Content="tired" Tag="Tired" />
                    <ComboBoxItem Content="rough" Tag="Rough" />
                </ComboBox>
                <TextBox Header="note" Text="{x:Bind ViewModel.CheckInNote, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="HomeCheckInNote" AutomationProperties.Name="note" />
                <Button Content="save check-in" Command="{x:Bind ViewModel.RecordCheckInCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="HomeSaveCheckIn" AutomationProperties.Name="save check-in" />
                <TextBlock x:Name="HomeCheckInSummary" Text="{x:Bind ViewModel.CheckInSummaryText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeCheckInSummary" AutomationProperties.Name="check-in summary" />
                <ItemsControl x:Name="HomeCheckInHistory" ItemsSource="{x:Bind ViewModel.RecentCheckIns, Mode=OneWay}" AutomationProperties.AutomationId="HomeCheckInHistory" AutomationProperties.Name="check-in history">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MoodCheckIn">
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Text="{x:Bind Choice}" />
                                <TextBlock Text="{x:Bind CreatedUtc}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox x:Name="StartupToggle" Content="launch dudu when i sign in" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" AutomationProperties.AutomationId="SettingsLaunchAtSignIn" AutomationProperties.Name="launch dudu when i sign in" />
                <TextBlock Text="startup registration is managed locally on this pc" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel x:Name="StartupRecoveryPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="StartupRecoveryMessage" AutomationProperties.AutomationId="HomeStartupRecoveryMessage" AutomationProperties.Name="startup recovery message" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" />
                    <Button x:Name="RetryStartupButton" Content="retry startup registration" AutomationProperties.AutomationId="HomeRetryStartupRegistration" AutomationProperties.Name="retry startup registration" Click="RetryStartupButton_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeStatusMessage" AutomationProperties.Name="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeErrorMessage" AutomationProperties.Name="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
